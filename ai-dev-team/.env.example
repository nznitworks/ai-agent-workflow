# Anthropic API Key
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Ollama Server URL
# Mac Mini (server):     http://localhost:11434
# Client Mac (LAN):      http://192.168.x.x:11434
# Remote (Tailscale):    http://100.x.x.x:11434
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model — must be pulled on the Mac Mini first
# ollama pull qwen2.5-coder:14b
OLLAMA_MODEL=qwen2.5-coder:14b

# Claude model for planning
CLAUDE_MODEL=claude-sonnet-4-5

# Your project root path
# Leave empty to use current working directory
PROJECT_PATH=

# Disable CrewAI telemetry (optional)
OTEL_SDK_DISABLED=true

# Disable CrewAI tracing prompt (optional)
CREWAI_TRACING_ENABLED=false
