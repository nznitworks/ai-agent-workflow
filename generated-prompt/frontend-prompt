Scaffold a new React TypeScript frontend for the AMIPDH Network Health 
Checker. Place the project in: frontend/

Tech stack:
- Vite + React 18 + TypeScript
- Tailwind CSS for styling
- React Router v6 for navigation
- TanStack Query (React Query) for API state management
- Axios for HTTP calls
- Vitest + React Testing Library for tests
- ESLint + Prettier configured

API base URL from environment variable: VITE_API_BASE_URL
Backend base path: /api/v1

Use these EXACT TypeScript interfaces derived from the FastAPI schemas:

// HTTP Check
interface HttpCheckRequest {
  url: string
  timeout_seconds?: number   // default 5.0, min 0.5, max 30.0
  expected_status?: number   // default 200, min 100, max 599
}
interface HttpCheckResponse {
  ok: boolean
  url: string
  status_code: number | null
  latency_ms: number | null
  detail: string
}

// Egress Check
interface EgressCheckRequest {
  urls: string[]             // min 1, max 50 items
  timeout_seconds?: number   // default 5.0, min 0.5, max 30.0
  expected_status?: number   // default 200, min 100, max 599
}
interface EgressUrlResult {
  url: string
  ok: boolean
  status_code: number | null
  latency_ms: number | null
  detail: string
}
interface EgressCheckResponse {
  ok: boolean
  total: number
  success_count: number
  failure_count: number
  results: EgressUrlResult[]
  detail: string
}

// DNS Check
interface DnsCheckRequest {
  hostname: string           // min 1, max 253 chars
  record_type?: 'A' | 'AAAA' // default 'A'
}
interface DnsCheckResponse {
  ok: boolean
  hostname: string
  record_type: string
  addresses: string[]
  detail: string
}

// TCP Check
interface TcpCheckRequest {
  host: string               // min 1, max 253 chars
  port: number               // min 1, max 65535
  timeout_seconds?: number   // default 5.0, min 0.5, max 30.0
}
interface TcpCheckResponse {
  ok: boolean
  host: string
  port: number
  latency_ms: number | null
  detail: string
}

// Health
interface HealthResponse {
  status: string
}

