# Anthropic API Key
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Ollama Server URL
# Mac Mini (server):     http://localhost:11434
# Client Mac (LAN):      http://192.168.x.x:11434
# Remote (Tailscale):    http://100.x.x.x:11434
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use for code execution
OLLAMA_MODEL=qwen2.5-coder:14b

# Claude model to use for planning
CLAUDE_MODEL=claude-sonnet-4-5

# Default project path (optional, can be passed via CLI)
# If not set, uses current working directory
PROJECT_PATH=
